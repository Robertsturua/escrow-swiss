<%- include('partials/header') %>

    <!-- OFFICIAL INSTITUTIONAL PROGRESS BAR STYLES FOR MOCKUP -->
    <style>
        .mockup-tracker .step-circle {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: #fff;
            border: 2px solid #cbd5e1;
            color: #94a3b8;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 16px;
            z-index: 2;
            transition: all 0.3s ease;
            margin: 0 auto;
        }

        .mockup-tracker .progress-step.active:not(.current) .step-circle {
            background-color: #10b981 !important; 
            border: 2px solid #064e3b !important; 
            color: white !important;
        }

        .mockup-tracker .progress-step.current .step-circle {
            background-color: #fff !important; 
            border: 3px solid #2563eb !important; 
            color: #2563eb !important;
            animation: subtle-glow 2.5s infinite alternate ease-in-out;
        }

        @keyframes subtle-glow {
            0% { box-shadow: 0 0 4px rgba(37, 99, 235, 0.2), 0 0 0 2px rgba(37, 99, 235, 0.05); }
            100% { box-shadow: 0 0 12px rgba(37, 99, 235, 0.5), 0 0 0 5px rgba(37, 99, 235, 0.15); }
        }

        /* DESKTOP LAYOUT (Default) */
        .mockup-tracker .progress-bar-container {
            position: relative;
            display: flex;
            justify-content: space-between;
            margin-top: 40px; 
            background: white; 
            padding: 40px 20px; 
            border-radius: 8px; 
            border: 1px solid #e2e8f0; 
            box-shadow: 0 4px 15px rgba(0,0,0,0.02);
        }
        .mockup-tracker .progress-line { 
            background-color: #e2e8f0 !important; 
            position: absolute;
            top: 60px; 
            left: 10%;
            right: 10%;
            height: 2px;
            z-index: 1;
        }
        .mockup-tracker .progress-step {
            text-align: center;
            flex: 1;
            position: relative;
            z-index: 2;
        }
        .mockup-tracker .progress-step span {
            color: #94a3b8;
            font-weight: 500;
            margin-top: 15px;
            font-size: 14px;
            display: block;
        }
        .mockup-tracker .progress-step.active:not(.current) span { color: #10b981; }
        .mockup-tracker .progress-step.current span { color: #2563eb; font-weight: 700; }

        /* --- MOBILE RESPONSIVE FIXES (VERTICAL TIMELINE) --- */
        @media (max-width: 768px) {
            .mockup-tracker .progress-bar-container {
                flex-direction: column !important;
                padding: 30px 25px !important;
                gap: 30px !important;
            }
            .mockup-tracker .progress-line {
                top: 40px !important; 
                bottom: 40px !important;
                left: 44px !important; /* Perfectly centers the line behind the circles */
                width: 2px !important;
                height: auto !important;
                right: auto !important;
            }
            .mockup-tracker .progress-step {
                display: flex !important;
                flex-direction: row !important;
                align-items: center !important;
                text-align: left !important;
            }
            .mockup-tracker .step-circle {
                width: 38px !important;
                height: 38px !important;
                margin: 0 !important;
                flex-shrink: 0;
            }
            .mockup-tracker .progress-step span {
                margin-top: 0 !important;
                margin-left: 20px !important;
                font-size: 15px !important;
            }
        }
    </style>

